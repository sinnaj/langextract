        "obligation_type": "MANDATORY",
        "norm_statement": "Every floor that is not a null occupancy zone and does not have an accessible building exit must provide the possibility of passage to an alternative fire sector via an accessible floor exit or a refuge area suitable for the specified number of spaces.",
        "applies_if": "(BUILDING.USAGE == 'RESIDENTIAL.HOUSING' AND BUILDING.EVACUATION.HEIGHT > 28) OR (BUILDING.USAGE IN ['PUBLIC.RESIDENTIAL', 'ADMINISTRATIVE', 'EDUCATION'] AND BUILDING.EVACUATION.HEIGHT > 14) OR (BUILDING.USAGE IN ['COMMERCIAL', 'PUBLIC.ASSEMBLY'] AND BUILDING.EVACUATION.HEIGHT > 10) OR (FLOOR.USAGE == 'PARKING' AND FLOOR.AREA > 1500 AND FLOOR.OCCUPANCY != 0 AND NOT HAS(FLOOR.EXIT.ACCESSIBLE))",
        "satisfied_if": "HAS(FLOOR.EXIT.ACCESSIBLE.TO_ALTERNATIVE_FIRE_SECTOR) OR (HAS(FLOOR.REFUGE_AREA) AND FLOOR.REFUGE_AREA.CAPACITY.WHEELCHAIR_USER >= CEIL(FLOOR.OCCUPANTS / 100) AND (BUILDING.USAGE == 'RESIDENTIAL.HOUSING' OR FLOOR.REFUGE_AREA.CAPACITY.REDUCED_MOBILITY_PERSON >= CEIL(FLOOR.OCCUPANTS / 33)))",
