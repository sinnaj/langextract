    {
      "extraction_class": "NORM",
      "extraction_text": "Los edificios con una altura de evacuación descendente mayor que 9 m deben disponer de un espacio de maniobra para los bomberos que cumpla las siguientes condiciones a lo largo de las fachadas en las que estén situados los accesos , o bien al interior del edificio, o bien al espacio abierto interior en el que se encuentren aquellos:",
      "attributes": {
        "id": "si5_1_2_1_maneuver_space_conditions",
        "parent_section_id": "38ffc4424a53526b",
        "paragraph_number": 1,
        "obligation_type": "MANDATORY",
        "norm_statement": "Buildings with a downward evacuation height greater than 9m must have a maneuver space for firefighters that meets specified conditions along the facades where accesses are located, either to the interior of the building or to the interior open space where they are located.",
        "applies_if": "BUILDING.EVACUATION.HEIGHT.DOWNWARD > 9",
        "satisfied_if": "BUILDING.FIRE_BRIGADE.MANEUVER_SPACE.EXISTS == TRUE AND BUILDING.FIRE_BRIGADE.MANEUVER_SPACE.MEETS_CONDITIONS == TRUE",
        "exempt_if": "FALSE",
