        "parent_section_id": "ee397064d26313e4",
        "paragraph_number": 3,
        "obligation_type": "MANDATORY",
        "norm_statement": "For establishments with fewer than 20 lodging places, installing a detection and alarm system may be chosen as an alternative to the requirement for a protected staircase.",
